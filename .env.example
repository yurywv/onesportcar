# PostgreSQL (produção: Neon/Supabase/RDS em região Brasil, ex.: aws-sa-east-1)
DATABASE_URL="postgresql://usuario:senha@host:5432/onesportcar?sslmode=require"
# Conexão direta (sem pooler) usada pelas migrations — a integração Neon da Vercel cria esta variável automaticamente. Localmente, igual ao DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/onesportcar?sslmode=require"
