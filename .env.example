# PostgreSQL (produção: Neon/Supabase/RDS em região Brasil, ex.: aws-sa-east-1)
DATABASE_URL="postgresql://usuario:senha@host:5432/onesportcar?sslmode=require"
# Conexão direta (sem pooler) usada pelas migrations — a integração Neon da Vercel cria esta variável automaticamente. Localmente, igual ao DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/onesportcar?sslmode=require"
# Emissão de NFS-e/NF-e (Focus NFe). Token por ambiente, gerado no painel da Focus após cadastrar a DBL com o certificado A1.
# Sem token, o sistema gera a prévia da nota mas não transmite.
FISCAL_TOKEN_HOMOLOGACAO=""
FISCAL_TOKEN_PRODUCAO=""
# Campanhas — e-mail via Resend (domínio onesportcar.com.br verificado no Resend)
RESEND_API_KEY=""
MAIL_FROM="One Sportcar <contato@onesportcar.com.br>"
MAIL_REPLY_TO="comercial@onesportcar.com.br"
# Campanhas — WhatsApp Cloud API (Meta Business). Sem estas chaves, use o "envio assistido".
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Segredo do Vercel Cron (a Vercel envia "Authorization: Bearer $CRON_SECRET" ao chamar /api/cron/campanhas)
CRON_SECRET=""
